{
  "name": "xdp-pdf-render",
  "version": "0.1.0",
  "description": "Render PDF documents from XDP templates, XSD schemas, and XML data — no SAP/Adobe dependency",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "xdp-pdf": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest --forceExit",
    "test:unit": "jest --forceExit --testPathPattern=test/unit",
    "test:integration": "jest --forceExit --testPathPattern=test/integration",
    "lint": "eslint src/**/*.ts",
    "verify": "npm run build && node scripts/verify-pdf.mjs",
    "format": "prettier --write src/ test/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "xdp",
    "xsd",
    "pdf",
    "forms",
    "template",
    "xml",
    "adobe-forms",
    "sap"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SanjayBabuSP/xdp-pdf-renderer"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "commander": "^12.0.0",
    "fast-xml-parser": "^4.5.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.0.0",
    "jest": "^29.0.0",
    "pdfjs-dist": "^4.10.38",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.0"
  }
}
