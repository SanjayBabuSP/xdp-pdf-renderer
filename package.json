{
  "name": "@sanjay-sde/xdp-pdf-renderer",
  "version": "0.4.0",
  "description": "Render PDF documents from XDP templates, XSD schemas, and XML data — no SAP/Adobe dependency",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "xdp-pdf": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.d.ts.map",
    "assets/fonts/*.ttf",
    "assets/fonts/LICENSE-DejaVu.txt",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:unit": "jest --testPathPattern=test/unit",
    "test:integration": "jest --testPathPattern=test/integration",
    "test:coverage": "jest --testPathPattern=test/unit --coverage --collectCoverageFrom='src/**/*.ts' --coverageReporters=json-summary --coverageReporters=text-summary",
    "test:debug": "jest --detectOpenHandles --runInBand --testPathPattern=test/unit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "verify": "npm run build && node scripts/verify-pdf.mjs",
    "fonts:import": "node scripts/import-adobe-fonts.mjs",
    "locales:import": "node scripts/import-xfa-locale.mjs",
    "sanitize:forms": "node scripts/sanitize-forms.mjs",
    "sample-forms": "npm run build && node scripts/render-sample-forms.mjs",
    "check:size": "node scripts/check-pack-size.mjs",
    "bench": "npm run build && node scripts/bench-render.mjs",
    "format": "prettier --write src/ test/",
    "format:check": "prettier --check src/ test/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "xdp",
    "xsd",
    "pdf",
    "forms",
    "template",
    "xml",
    "adobe-forms",
    "sap"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SanjayBabuSP/xdp-pdf-renderer.git"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "commander": "^12.0.0",
    "fast-xml-parser": "^5.12.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.20.5",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.15.0",
    "jest": "^29.0.0",
    "pdfjs-dist": "^4.10.38",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.0"
  }
}
