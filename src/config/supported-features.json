{
  "version": "1.0",
  "supported": {
    "layouts": ["tb", "lr", "table", "row", "position"],
    "fieldTypes": ["textEdit", "numericEdit", "dateTimeEdit", "imageEdit", "checkButton", "choiceList", "barcode", "button", "signature"],
    "presenceValues": ["visible", "hidden", "invisible", "inactive"],
    "xsdTypes": ["string", "int", "byte", "short", "integer", "decimal", "float", "date", "dateTime", "anyURI"],
    "drawTypes": ["text", "image", "richText", "rectangle", "line", "arc", "circle"],
    "templateNamespaces": [
      "http://www.xfa.org/schema/xfa-template/2.8/",
      "http://www.xfa.org/schema/xfa-template/3.3/",
      "http://www.xfa.org/schema/xfa-template/3.6/"
    ],
    "captionPlacements": ["left", "right", "top", "bottom", "inline"],
    "borderStyles": ["solid", "dashed", "dotted", "dashDot", "dashDotDot"],
    "fontSubstitution": true,
    "fontEquateRules": true,
    "standardPdfFonts": ["Courier", "Helvetica", "Times", "Symbol", "ZapfDingbats"],
    "unicodeFontFallback": true,
    "fontColors": true,
    "stockMediaSizes": true,
    "maxOccurLimit": 10000,
    "maxInputSizeBytes": 10485760
  },
  "unsupported": {
    "features": ["acroForms", "barcodeRendering", "gradientFills", "iccColorManagement"],
    "partialSupport": ["richTextFormatting", "cornerRadius"],
    "imageFormats": ["image/bmp", "image/gif", "image/tiff"]
  }
}
