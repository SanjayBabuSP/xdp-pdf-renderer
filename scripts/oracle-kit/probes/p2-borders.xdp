<?xml version="1.0" encoding="UTF-8"?>
<!-- P2 border geometry and styles
     Generated by make-probes.mjs. Single-variable layout probe.
     Content area: x=36 y=36 w=523 h=769 (pt), medium a4.
     Boxes are allocated so that none overlap; each text run maps to one box.
-->
<xdp:xdp xmlns:xdp="http://ns.adobe.com/xdp/">
  <template xmlns="http://www.xfa.org/schema/xfa-template/3.3/">
    <subform name="probe" layout="tb" locale="en_US">
      <pageSet>
        <pageArea name="Page1" id="Page1">
          <contentArea x="36pt" y="36pt" w="523pt" h="769pt"/>
          <medium stock="a4" short="595.276pt" long="841.89pt"/>
        </pageArea>
      </pageSet>
      <subform name="rows" layout="position">
      <field name="b_thin" x="36pt" y="36pt" w="110pt" h="70pt">
        <ui><textEdit/></ui>
        <font typeface="Helvetica" size="8pt"/>
        
        <border><edge thickness="0.5pt"/></border>
        <bind match="dataRef" ref="$.b_thin"/>
      </field>
      <field name="b_hair" x="161pt" y="36pt" w="110pt" h="70pt">
        <ui><textEdit/></ui>
        <font typeface="Helvetica" size="8pt"/>
        
        <border><edge thickness="0.25pt"/></border>
        <bind match="dataRef" ref="$.b_hair"/>
      </field>
      <field name="b_thick" x="286pt" y="36pt" w="110pt" h="70pt">
        <ui><textEdit/></ui>
        <font typeface="Helvetica" size="8pt"/>
        
        <border><edge thickness="3pt"/></border>
        <bind match="dataRef" ref="$.b_thick"/>
      </field>
      <field name="b_dashed2" x="411pt" y="36pt" w="110pt" h="70pt">
        <ui><textEdit/></ui>
        <font typeface="Helvetica" size="8pt"/>
        
        <border><edge stroke="dashed" thickness="2pt"/></border>
        <bind match="dataRef" ref="$.b_dashed2"/>
      </field>
      <field name="b_dotted1" x="36pt" y="126pt" w="110pt" h="70pt">
        <ui><textEdit/></ui>
        <font typeface="Helvetica" size="8pt"/>
        
        <border><edge stroke="dotted" thickness="1pt"/></border>
        <bind match="dataRef" ref="$.b_dotted1"/>
      </field>
      <field name="b_dashdot" x="161pt" y="126pt" w="110pt" h="70pt">
        <ui><textEdit/></ui>
        <font typeface="Helvetica" size="8pt"/>
        
        <border><edge stroke="dashDot" thickness="1pt"/></border>
        <bind match="dataRef" ref="$.b_dashdot"/>
      </field>
      <field name="b_dashdotdot" x="286pt" y="126pt" w="110pt" h="70pt">
        <ui><textEdit/></ui>
        <font typeface="Helvetica" size="8pt"/>
        
        <border><edge stroke="dashDotDot" thickness="1.5pt"/></border>
        <bind match="dataRef" ref="$.b_dashdotdot"/>
      </field>
      <field name="b_solid05" x="411pt" y="126pt" w="110pt" h="70pt">
        <ui><textEdit/></ui>
        <font typeface="Helvetica" size="8pt"/>
        
        <border><edge thickness="0.5pt"/></border>
        <bind match="dataRef" ref="$.b_solid05"/>
      </field>
      <field name="b_capround" x="36pt" y="216pt" w="110pt" h="70pt">
        <ui><textEdit/></ui>
        <font typeface="Helvetica" size="8pt"/>
        
        <border><edge stroke="dashed" thickness="2pt" cap="round"/></border>
        <bind match="dataRef" ref="$.b_capround"/>
      </field>
      <field name="b_capsquare" x="161pt" y="216pt" w="110pt" h="70pt">
        <ui><textEdit/></ui>
        <font typeface="Helvetica" size="8pt"/>
        
        <border><edge stroke="dashed" thickness="2pt" cap="square"/></border>
        <bind match="dataRef" ref="$.b_capsquare"/>
      </field>
      <field name="b_joinbevel" x="286pt" y="216pt" w="110pt" h="70pt">
        <ui><textEdit/></ui>
        <font typeface="Helvetica" size="8pt"/>
        
        <border><edge thickness="2pt" cap="butt" join="bevel"/></border>
        <bind match="dataRef" ref="$.b_joinbevel"/>
      </field>
      <field name="b_joinmiter" x="411pt" y="216pt" w="110pt" h="70pt">
        <ui><textEdit/></ui>
        <font typeface="Helvetica" size="8pt"/>
        
        <border><edge thickness="2pt" cap="butt" join="miter"/></border>
        <bind match="dataRef" ref="$.b_joinmiter"/>
      </field>
      <field name="b_edgehidden" x="36pt" y="306pt" w="110pt" h="70pt">
        <ui><textEdit/></ui>
        <font typeface="Helvetica" size="8pt"/>
        
        <border><edge thickness="2pt"/></border>
        <bind match="dataRef" ref="$.b_edgehidden"/>
      </field>
      <field name="b_peredge" x="36pt" y="336pt" w="200pt" h="80pt">
        <ui><textEdit/></ui>
        <font typeface="Helvetica" size="8pt"/>
        
        <border><edge thickness="1pt"><color value="255,0,0"/></edge><edge thickness="2pt"><color value="0,255,0"/></edge><edge thickness="3pt"><color value="0,0,255"/></edge><edge thickness="4pt"><color value="0,0,0"/></edge></border>
        <bind match="dataRef" ref="$.b_peredge"/>
      </field>
      <field name="b_radius_2" x="266pt" y="336pt" w="120pt" h="70pt">
        <ui><textEdit/></ui>
        <font typeface="Helvetica" size="8pt"/>
        
        <border><edge thickness="1.5pt"><color value="0,0,0"/></edge><corner radius="2pt"/></border>
        <bind match="dataRef" ref="$.b_radius_2"/>
      </field>
      <field name="b_radius_6" x="266pt" y="336pt" w="120pt" h="70pt">
        <ui><textEdit/></ui>
        <font typeface="Helvetica" size="8pt"/>
        
        <border><edge thickness="1.5pt"><color value="0,0,0"/></edge><corner radius="6pt"/></border>
        <bind match="dataRef" ref="$.b_radius_6"/>
      </field>
      <field name="b_radius_14" x="266pt" y="426pt" w="120pt" h="70pt">
        <ui><textEdit/></ui>
        <font typeface="Helvetica" size="8pt"/>
        
        <border><edge thickness="1.5pt"><color value="0,0,0"/></edge><corner radius="14pt"/></border>
        <bind match="dataRef" ref="$.b_radius_14"/>
      </field>
      <field name="b_radius_30" x="266pt" y="606pt" w="120pt" h="70pt">
        <ui><textEdit/></ui>
        <font typeface="Helvetica" size="8pt"/>
        
        <border><edge thickness="1.5pt"><color value="0,0,0"/></edge><corner radius="30pt"/></border>
        <bind match="dataRef" ref="$.b_radius_30"/>
      </field>
      <field name="b_fill_gray" x="36pt" y="436pt" w="110pt" h="60pt">
        <ui><textEdit/></ui>
        <font typeface="Helvetica" size="8pt"/>
        
        <border><fill><color value="128,128,128"/></fill><edge thickness="1pt"/></border>
        <bind match="dataRef" ref="$.b_fill_gray"/>
      </field>
      <field name="b_fill_rgb" x="166pt" y="436pt" w="110pt" h="60pt">
        <ui><textEdit/></ui>
        <font typeface="Helvetica" size="8pt"/>
        
        <border><fill><color value="12,200,90"/></fill><edge thickness="1pt"/></border>
        <bind match="dataRef" ref="$.b_fill_rgb"/>
      </field>
      </subform>
    </subform>
  </template>
  <config xmlns="http://ns.adobe.com/xci/3.0/">
    <present><pdf><version>1.7</version></pdf></present>
  </config>
  <connectionSet xmlns="http://ns.adobe.com/xfa-connection-set/2.8/">
    <xsdConnection name="DataConnection" dataDescription="probe">
      <uri>./probe.xsd</uri>
      <rootElement>probe</rootElement>
    </xsdConnection>
  </connectionSet>
</xdp:xdp>
